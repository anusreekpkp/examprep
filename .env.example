# ---------------------------------------------------------------------------
# Copy to server/.env for local development. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Neon Postgres connection string. Use the POOLED host (contains "-pooler").
# Prefer sslmode=verify-full over Neon's default require: it actually verifies
# the server certificate, and pg v9 will weaken the meaning of "require".
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/examprep?sslmode=verify-full&channel_binding=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="change-me-too-and-make-it-different"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Server
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# AI (Phase 8 - leave blank until then)
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Copy to server/.env for local development. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (pooled, includes ?sslmode=require)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/examprep?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="change-me-too-and-make-it-different"
REFRESH_TOKEN_EXPIRES_IN="30d"

# Server
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# AI (Phase 8 - leave blank until then)
ANTHROPIC_API_KEY=""
